# Copy this file to .env and fill in your values.
# The app reads environment variables directly — this file is not auto-loaded.
#
# Docker:    docker run --env-file .env ...
# Local dev: export $(grep -v '^#' .env | xargs) && go run ./cmd/fetchplane
#
# Floatplane OAuth
# You need a Floatplane-issued OAuth client ID for this app.
FP_OAUTH_CLIENT_ID=your_registered_client_id
# Default scope is: "openid videos:watch account:read"
FP_OAUTH_SCOPE=openid videos:watch account:read

# Where to save videos (default: "downloads" relative to working directory)
FP_DOWNLOAD_DIR=/data/videos

# Polling interval in seconds when running with -daemon (default: 300)
FP_POLL_INTERVAL=300

# Optional: where to persist seen attachments and per-creator release cutoffs.
# Default: $FP_DOWNLOAD_DIR/.fetchplane-state.json
FP_STATE_FILE=/data/videos/.fetchplane-state.json

# Only download videos released after this date (optional).
# Accepts RFC3339 (2024-01-15T00:00:00Z) or plain date (2024-01-15).
# If unset, all videos are considered. Set this to avoid pulling years of backlog.
FP_SINCE=2026-06-01
